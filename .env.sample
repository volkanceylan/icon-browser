# Copy to .env and fill in.
# Used by `npm run synonyms` (scripts/build-synonyms.mjs).

# Required. API key for the AI provider.
ICON_BROWSER_API_KEY=

# OpenAI-compatible chat completions endpoint.
ICON_BROWSER_API_URL=https://opencode.ai/inference/go/openai/v1/chat/completions

# Model name.
ICON_BROWSER_MODEL=deepseek-v4.1-flash
